# MongoDB Connection URI (e.g., mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority)
MONGODB_URI=mongodb://localhost:27017

# Secret key for JWT signing (use a long, random string in production)
JWT_SECRET_KEY=my_super_secret_jwt_key_12345

# Algorithm used for JWT encoding/decoding
JWT_ALGORITHM=HS256

# Expiration time for JWT tokens in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
